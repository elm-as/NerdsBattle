# Copier ce fichier en .env et remplir les valeurs.
# NE JAMAIS commiter .env dans git.

# ─── Supabase (frontend) ──────────────────────────────────
# Settings → API → Project URL
VITE_SUPABASE_URL=https://xxxx.supabase.co
# Settings → API → Project API keys → publishable key (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# ─── Script génération locale (scripts/generate-course.mjs) ──
# Clé DeepSeek : https://platform.deepseek.com/api_keys
API_KEY=sk-...
API_BASE_URL=https://api.deepseek.com/v1
API_MODEL=deepseek-chat
QUESTION_COUNT=6

# ─── Supabase Edge Function secrets (à configurer via CLI) ───
# supabase secrets set DEEPSEEK_API_KEY=sk-...
# (ne pas mettre ici — ces secrets vont directement dans Supabase)
